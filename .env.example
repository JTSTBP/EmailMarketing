# Local default. Do not use APP_MODE=mock on a public host: demo auth is local-only.
APP_MODE=mock
LOCAL_MICROSOFT_TEST=false
HOST=127.0.0.1
PORT=4100
APP_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/jt_outreach?replicaSet=rs0
ENABLE_LIVE_SENDING=false
GRAPH_THREADING_VERIFIED=false

# Server-side AI configuration. No real AI calls in mock provider mode.
AI_PROVIDER=mock
GEMINI_MODEL=
GEMINI_API_KEY=
# Optional USD per 1,000,000 tokens; verify prices for your chosen model.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Live CRM integration: dedicated least-scope HMAC secret, 32+ random characters.
CRM_BASE_URL=
CRM_INTEGRATION_SECRET=
# Base64 of 32 random bytes; never change without migrating encrypted records.
TOKEN_ENCRYPTION_KEY=

# Microsoft business tenant, confidential web OAuth app, delegated permissions.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://outreach.example.com/api/oauth/callback
MS_WEBHOOK_URL=https://outreach.example.com/api/graph/notifications
